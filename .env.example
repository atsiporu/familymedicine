# Copy to .env and adjust. .env is git-ignored.
DEBUG=true
# Generate for production: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Development database. Never point a dev checkout at the production database.
DATABASE_URL=postgres:///portal_dev
ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://portal.office.lan when served through Caddy
CSRF_TRUSTED_ORIGINS=
SESSION_IDLE_SECONDS=1800
TIME_ZONE=America/New_York

OLLAMA_URL=http://127.0.0.1:11434
AI_DEFAULT_MODEL=gpt-oss:120b
# Comma-separated allow-list; empty = all installed models
AI_ALLOWED_MODELS=
AI_MAX_CONCURRENT=1
# Store prompt/response text in the DB. Keep false: prompts may contain PHI.
AI_STORE_CONTENT=false
